# Copy to .env and edit. Only KIST_TOKEN is required; everything else has a
# sensible default (commented-out lines show it).

# Required. The owner's bearer token (scope admin) for the API, web UI, and
# MCP endpoint. Narrower named tokens are made with POST /api/tokens.
# Kist refuses to start with this placeholder or anything under 16 chars.
# Generate one with:
#   openssl rand -hex 24
KIST_TOKEN=change-me

# Host port for the web UI / API (a port number only).
KIST_PORT=8080

# Host address to listen on. 0.0.0.0 is every interface, so anyone on the LAN
# can reach Kist over plain HTTP. When the TLS reverse proxy (SWAG, Caddy,
# nginx) runs on the same host, use 127.0.0.1. (If you used to set
# KIST_PORT=127.0.0.1:8080, move the address here.)
# KIST_BIND=0.0.0.0

# Where the asset library lives on the host (bind mount).
KIST_LIBRARY=./library

# Postgres password. Postgres is only reachable inside the compose network,
# but don't leave it at the default.
KIST_DB_PASSWORD=kist

# Optional: User-Agent for URL downloads. Some sites (e.g. Wikimedia) refuse
# tools whose User-Agent has no contact info, e.g.
#   KIST_USER_AGENT=kist/1.0 (you@example.com)
KIST_USER_AGENT=

# The address you open Kist at, e.g. https://kist.example.com. MCP results
# then carry absolute web_url links agents can hand you; empty = site-relative.
KIST_PUBLIC_URL=

# ---- optional ----

# "Add from URL" refuses private/LAN/loopback addresses unless allowed.
# KIST_URL_ALLOW_PRIVATE=false
# Comma list of host names and/or CIDR ranges allowed anyway:
# KIST_URL_ALLOW_HOSTS=nas.lan,192.168.1.0/24

# Time limits (seconds): one URL download; one item's preview generation.
# KIST_DOWNLOAD_TIMEOUT_SECONDS=120
# KIST_PREVIEW_TIMEOUT_SECONDS=300
# Largest URL download (MB) and direct upload (bytes; 4 GiB).
# KIST_MAX_DOWNLOAD_MB=512
# KIST_MAX_UPLOAD_BYTES=4294967296

# A job running longer than this is taken to belong to a stopped worker and
# is queued again; keep it above the two time limits above.
# KIST_JOB_LEASE_SECONDS=900

# The worker checks the library against the database this often (hours);
# 0 turns it off. GET /api/health/deep reports the last result.
# KIST_VERIFY_INTERVAL_HOURS=24

# Items in the trash longer than this many days are deleted for good by the
# worker (never protected items); 0 keeps the trash forever. The clock starts
# the first time the worker runs with it on, so an upgrade never empties an
# old trash at once.
# KIST_TRASH_RETENTION_DAYS=30

# Backups (`docker compose exec worker kist backup`): a restic repository
# (a path mounted into the worker, or sftp:, rest:, s3:, b2: ...) and its
# password. The worker also runs it every KIST_BACKUP_INTERVAL_HOURS
# (0 = only by hand). /api/archive-health shows the last result.
# KIST_BACKUP_REPO=/backup
# RESTIC_PASSWORD=
# RESTIC_PASSWORD_FILE=
# KIST_BACKUP_INTERVAL_HOURS=0

# How often the worker looks in library/inbox and the job queue (seconds).
# KIST_INBOX_POLL_SECONDS=5
# KIST_WORKER_POLL_SECONDS=2

# Strict-Transport-Security max-age (180 days); 0 turns it off.
# KIST_HSTS_SECONDS=15552000

# DEBUG, INFO, WARNING or ERROR.
# KIST_LOG_LEVEL=INFO

# Set when building, so /api/version names the deployed commit:
#   KIST_GIT_COMMIT=$(git rev-parse --short HEAD) docker compose build
# KIST_GIT_COMMIT=unknown

# Containers' user (must own the library folder) and memory cap each.
# KIST_UID=1000
# KIST_GID=1000
# KIST_MEM_LIMIT=4g

# ---- AI (the ml service: embeddings + OCR, on the CPU) ----

# Queue embedding/OCR jobs for new items; false turns AI off.
# KIST_AI_ENABLED=true
# The embedding model (ml service, app and worker use the same one).
# ViT-B-16-SigLIP2__webli is the opt-in alternative: 768-d, ~2.5x slower.
# KIST_ML_MODEL=ViT-B-32__openai
# When `kist ai-backfill` jobs may run (time zone TZ; may wrap past
# midnight). Empty: any time. New items' jobs never wait for it.
# KIST_AI_WINDOW=01:00-06:00
# TZ=UTC
# AI jobs the worker runs at once; embed jobs per ml request (max 32);
# scanned PDF pages to OCR.
# KIST_AI_CONCURRENCY=2
# KIST_AI_EMBED_BATCH=16
# KIST_AI_OCR_PDF_PAGES=5
# The ml service: inference threads per request (4 keeps a 10-core NAS
# responsive), requests at once, memory and CPU caps.
# KIST_ML_THREADS=4
# KIST_ML_CONCURRENCY=1
# KIST_ML_MEM_LIMIT=2g
# KIST_ML_CPUS=4
# Intel GPU through OpenVINO: build with KIST_ML_OPENVINO=1, set the device,
# and uncomment devices/group_add for /dev/dri in docker-compose.yml.
# KIST_ML_OPENVINO=0
# KIST_ML_DEVICE=cpu
# KIST_RENDER_GID=105
# Unload a model after this long unused (seconds); model file mirror.
# KIST_ML_IDLE_SECONDS=300
# KIST_ML_BASE_URL=https://huggingface.co
# Another ml service, e.g. on a faster machine (empty: the worker runs no AI
# jobs itself; `kist helper` can still take them).
# KIST_ML_URL=http://ml:8000

# ---- captions (optional; off unless a provider is set) ----
# ollama keeps images at home. openai, anthropic and gemini are bring-your-
# own-key: EVERY IMAGE YOU CAPTION IS SENT TO THAT COMPANY.
# KIST_CAPTION_PROVIDER=ollama
# Ollama's address (empty with ollama: a Mac running
# `kist helper --kinds caption` and Ollama does them). For openai, an
# OpenAI-compatible server's /v1 address instead of api.openai.com.
# KIST_CAPTION_URL=http://ollama:11434
# KIST_CAPTION_MODEL=qwen2.5vl:3b
# KIST_CAPTION_API_KEY=
# Caption every new item (otherwise on request and by
# `kist ai-backfill --kind caption`).
# KIST_CAPTION_AUTO=false
# KIST_CAPTION_PROMPT=
# KIST_CAPTION_TIMEOUT_SECONDS=180

# ---- organising (Kist 2.0 milestone 2) ----
# Faces and people, opt-in: queue `faces` jobs for images (app and worker)
# and load YuNet + SFace in the ml service (~39 MB, Apache-2.0, downloaded
# from github.com/opencv/opencv_zoo on first use and checked by sha256).
# Face data never leaves your server.
# KIST_FACES=0
# A mirror for the two face model files (they're checked by sha256 anyway).
# KIST_FACE_MODELS_URL=
# How often the worker recomputes suggested collections (hours; 0 = only
# when asked with GET /api/collections/suggested?refresh=1).
# KIST_COLLECTIONS_INTERVAL_HOURS=24

# ---- sharing, exports, provenance (Kist 2.0 milestone 4) ----
# Finished portable exports (library/exports/) are deleted after this many
# days; 0 keeps them.
# KIST_EXPORT_RETENTION_DAYS=7
# Let "save page" fetch an item's page on the server (through the same SSRF
# guard as URL adds) when the browser didn't send one.
# KIST_SNAPSHOTS=false
# The link-rot watch: re-check every item's source page this often (days),
# pausing this long between requests. Off (0) by default: once Kist has its
# copy it leaves the source site alone. Its findings are informational only
# (the item's info panel and the "Source page" filter), never "Needs attention".
# KIST_LINK_CHECK_DAYS=0
# KIST_LINK_CHECK_DELAY_SECONDS=2
# Ask the Wayback Machine (archive.org, an outside service) for an archived
# copy of sources that are gone. Off: it tells archive.org what you kept.
# KIST_WAYBACK=false
# Write items/<id>/original.xmp for images (Lightroom, darktable, digiKam).
# KIST_XMP_SIDECARS=true
# Wrong share-link passwords allowed per link per 15 minutes.
# KIST_SHARE_PASSWORD_ATTEMPTS=10

# ---- media: video, audio, photos, 3D, maps (Kist 2.0 milestone 5) ----

# ffmpeg runs under `nice` with this many threads (scrub sprites, waveforms,
# proxies, clips). Raise it on a strong machine, keep it low on a NAS.
# KIST_FFMPEG_THREADS=2
# Hardware encoding of web-safe proxies and clips on an Intel iGPU: qsv or
# vaapi (none = the CPU). Uncomment devices/group_add for /dev/dri under
# the worker in docker-compose.yml. A failed GPU encode falls back to the CPU.
# KIST_HWACCEL=none
# KIST_VAAPI_DEVICE=/dev/dri/renderD128
# Frames in a video's hover-scrub sprite.
# KIST_SCRUB_FRAMES=20
# Longest clip in seconds (mp4/mp3/wav), and for animated GIF/WebP clips.
# KIST_CLIP_MAX_SECONDS=600
# KIST_GIF_MAX_SECONDS=60
# Web-safe proxies (for ProRes, HEVC, AVI ...): long side at most this.
# KIST_PROXY_MAX_SIDE=1920
# Use exiftool (in the image) for camera data and RAW previews; false uses
# only Kist's built-in reader.
# KIST_EXIFTOOL=true
# Zip files kept as bundles: limits that make a zip bomb harmless.
# KIST_BUNDLE_MAX_ENTRIES=20000
# KIST_BUNDLE_MAX_TOTAL_MB=8192
# KIST_BUNDLE_MAX_ENTRY_MB=1024
# The web map's tiles: empty uses a Protomaps PMTiles file you download into
# the library (see docs/maps.md); or a hosted tile URL and its credit line.
# Place names come from `kist geo-download` (GeoNames, offline afterwards).
# KIST_MAP_TILES_URL=
# KIST_MAP_ATTRIBUTION=
