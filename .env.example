# Copy to .env and edit. Only KIST_TOKEN is required; everything else has a
# sensible default (commented-out lines show it).

# Required. Shared bearer token for the API, web UI, and MCP endpoint.
# Kist refuses to start with this placeholder or anything under 16 chars.
# Generate one with:
#   openssl rand -hex 24
KIST_TOKEN=change-me

# Host port for the web UI / API (a port number only).
KIST_PORT=8080

# Host address to listen on. 0.0.0.0 is every interface, so anyone on the LAN
# can reach Kist over plain HTTP. When the TLS reverse proxy (SWAG, Caddy,
# nginx) runs on the same host, use 127.0.0.1. (If you used to set
# KIST_PORT=127.0.0.1:8080, move the address here.)
# KIST_BIND=0.0.0.0

# Where the asset library lives on the host (bind mount).
KIST_LIBRARY=./library

# Postgres password. Postgres is only reachable inside the compose network,
# but don't leave it at the default.
KIST_DB_PASSWORD=kist

# Optional: User-Agent for URL downloads. Some sites (e.g. Wikimedia) refuse
# tools whose User-Agent has no contact info, e.g.
#   KIST_USER_AGENT=kist/1.0 (you@example.com)
KIST_USER_AGENT=

# The address you open Kist at, e.g. https://kist.example.com. MCP results
# then carry absolute web_url links agents can hand you; empty = site-relative.
KIST_PUBLIC_URL=

# ---- optional ----

# "Add from URL" refuses private/LAN/loopback addresses unless allowed.
# KIST_URL_ALLOW_PRIVATE=false
# Comma list of host names and/or CIDR ranges allowed anyway:
# KIST_URL_ALLOW_HOSTS=nas.lan,192.168.1.0/24

# Time limits (seconds): one URL download; one item's preview generation.
# KIST_DOWNLOAD_TIMEOUT_SECONDS=120
# KIST_PREVIEW_TIMEOUT_SECONDS=300
# Largest URL download (MB) and direct upload (bytes; 4 GiB).
# KIST_MAX_DOWNLOAD_MB=512
# KIST_MAX_UPLOAD_BYTES=4294967296

# A job running longer than this is taken to belong to a stopped worker and
# is queued again; keep it above the two time limits above.
# KIST_JOB_LEASE_SECONDS=900

# The worker checks the library against the database this often (hours);
# 0 turns it off. GET /api/health/deep reports the last result.
# KIST_VERIFY_INTERVAL_HOURS=24

# How often the worker looks in library/inbox and the job queue (seconds).
# KIST_INBOX_POLL_SECONDS=5
# KIST_WORKER_POLL_SECONDS=2

# Strict-Transport-Security max-age (180 days); 0 turns it off.
# KIST_HSTS_SECONDS=15552000

# DEBUG, INFO, WARNING or ERROR.
# KIST_LOG_LEVEL=INFO

# Set when building, so /api/version names the deployed commit:
#   KIST_GIT_COMMIT=$(git rev-parse --short HEAD) docker compose build
# KIST_GIT_COMMIT=unknown

# Containers' user (must own the library folder) and memory cap each.
# KIST_UID=1000
# KIST_GID=1000
# KIST_MEM_LIMIT=4g
