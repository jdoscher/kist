    { "src": "/icon-maskable-512.png?v=4", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-mono.svg?v=4", "sizes": "any", "type": "image/svg+xml", "purpose": "monochrome" },
    { "src": "/favicon.svg?v=4", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
